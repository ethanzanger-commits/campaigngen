# --- Optional: let people use YOUR OpenAI key via a shared access code ---
# Leave both unset and the site works only with visitors' own OpenAI keys (costs you nothing).
OPENAI_API_KEY=sk-...
# Use a long random value (16+ characters). Share it only with people you trust.
ACCESS_CODE=change-me-to-a-long-random-string

# Optional: model to use (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
